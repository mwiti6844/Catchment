# Production overlay settings. Copy to .env.production and fill in.
# NEVER commit .env.production — it is gitignored alongside .env.
#
# The application's own settings still come from .env (see .env.example).
# This file holds only what the production overlay adds.

# The DuckDNS subdomain pointing at this VPS, without a scheme.
# Example: catchment-david.duckdns.org
DUCKDNS_DOMAIN=

# Address Let's Encrypt uses for certificate-expiry notices.
ACME_EMAIL=
