# Copy to .env and fill in. .env is gitignored — never commit real values.
# Every setting below is read exclusively through catchment/config.py.

# --- Core infrastructure ---
CATCHMENT_DATABASE_URL=postgresql+psycopg://catchment:CHANGE_ME@localhost:5432/catchment
CATCHMENT_REDIS_URL=redis://localhost:6379/0
CATCHMENT_ENV=development
CATCHMENT_LOG_LEVEL=INFO

# --- Embeddings ---
CATCHMENT_EMBEDDING_MODEL=BAAI/bge-m3
CATCHMENT_EMBEDDING_DIM=1024

# --- Tag graph ---
# Hard ceiling on recursive walks over `tags`. See CLAUDE.md.
CATCHMENT_MAX_TAG_DEPTH=8

# --- Embeddings service ---
# BGE-M3 runs in its own container so the worker image stays lean.
CATCHMENT_EMBEDDER_URL=http://localhost:8001
CATCHMENT_EMBEDDER_TIMEOUT_SECONDS=120

# --- LLM router ---
# Swap providers by changing CATCHMENT_LLM_PROVIDER; tracing is applied by the
# router, so it survives the change. Registered providers: groq.
CATCHMENT_LLM_PROVIDER=groq
# Groq production models, cheapest-first. gpt-oss-120b is faster and ~4x
# cheaper on input than llama-3.3-70b; llama is the non-reasoning fallback if
# JSON mode ever misbehaves.
#   openai/gpt-oss-20b | openai/gpt-oss-120b | llama-3.3-70b-versatile
CATCHMENT_LLM_MODEL=openai/gpt-oss-120b
CATCHMENT_LLM_MAX_TOKENS=2048
CATCHMENT_LLM_TIMEOUT_SECONDS=60

# --- Classification ---
CATCHMENT_CLASSIFICATION_THRESHOLD=0.5
CATCHMENT_CLASSIFICATION_NEIGHBOURS=8
# Bounds what injected content can do to the taxonomy: ingested messages are
# written by other people, so a crafted item could steer the classifier.
CATCHMENT_MAX_NEW_TAGS_PER_ITEM=2
CATCHMENT_GROQ_API_KEY=

# --- Langfuse (self-hosted) ---
CATCHMENT_LANGFUSE_HOST=http://localhost:3000
CATCHMENT_LANGFUSE_PUBLIC_KEY=
CATCHMENT_LANGFUSE_SECRET_KEY=

# --- Ingestion connectors ---
CATCHMENT_WHATSAPP_WEBHOOK_SECRET=
CATCHMENT_WHATSAPP_VERIFY_TOKEN=
CATCHMENT_X_BOOKMARKS_TOKEN=
CATCHMENT_IMAP_HOST=
CATCHMENT_IMAP_PORT=993
CATCHMENT_IMAP_USERNAME=
CATCHMENT_IMAP_PASSWORD=
CATCHMENT_IMAP_FOLDER=INBOX
CATCHMENT_IMAP_BATCH_SIZE=50

# --- Integration tests (local only) ---
# CATCHMENT_TEST_DATABASE_URL=postgresql+psycopg://localhost/catchment_test
# CI also sets CATCHMENT_REQUIRE_INTEGRATION=1, which turns "no test database"
# from a skip into a failure. Leave it unset locally.
